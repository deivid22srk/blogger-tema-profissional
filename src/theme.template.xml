<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<!--
  ============================================================================
  TINTA & PAPEL — tema editorial profissional para Blogger
  Autor: deivid22srk · Licença: MIT · Documentação: docs/NOTAS.md
  Motor: Layouts v3 (b:layoutsVersion='3') com widgets versão 2.
  Este arquivo é o ESQUELETO: o build (scripts/build-theme.mjs) injeta
  o CSS do design system, o script principal e o widget Blog (src/blog-widget)
  nos marcadores de posição para gerar dist/theme.xml.
  ============================================================================
-->
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
  <head>
    <meta content='width=device-width, initial-scale=1' name='viewport'/>
    <title>
      <b:if cond='data:view.isHomepage'><data:blog.title/>
      <b:elseif cond='data:view.isError'/>Página não encontrada · <data:blog.title/>
      <b:else/><data:view.title.escaped/> · <data:blog.title/>
      </b:if>
    </title>
    <b:include data='blog' name='all-head-content'/>

    <!-- SEO: descrição de reserva e Open Graph -->
    <b:if cond='data:view.description'>
      <meta expr:content='data:view.description.escaped' name='description'/>
    </b:if>
    <meta expr:content='data:view.isMultipleItems ? &quot;website&quot; : &quot;article&quot;' property='og:type'/>
    <meta expr:content='data:view.title.escaped' property='og:title'/>
    <b:if cond='data:view.description'>
      <meta expr:content='data:view.description.escaped' property='og:description'/>
    </b:if>
    <meta expr:content='data:view.url.canonical' property='og:url'/>
    <b:if cond='data:view.featuredImage'>
      <meta expr:content='resizeImage(data:view.featuredImage, 1200, &quot;1200:630&quot;)' property='og:image'/>
    </b:if>
    <meta expr:content='data:blog.title' property='og:site_name'/>
    <meta expr:content='data:blog.locale' property='og:locale'/>
    <meta content='summary_large_image' name='twitter:card'/>
    <meta expr:content='data:view.title.escaped' name='twitter:title'/>
    <b:if cond='data:view.featuredImage'>
      <meta expr:content='resizeImage(data:view.featuredImage, 1200, &quot;1200:630&quot;)' name='twitter:image'/>
    </b:if>

    <!-- Ícone do blog e cores da interface do navegador -->
    <link expr:href='data:blog.blogspotFaviconUrl' rel='icon' type='image/x-icon'/>
    <meta expr:content='data:skin.vars.keycolor' name='theme-color'/>
    <meta content='#15120e' media='(prefers-color-scheme: dark)' name='theme-color'/>

    <!-- Tipografia: Fraunces (títulos) + Inter (texto) — um request, display swap -->
    <link href='https://fonts.googleapis.com' rel='preconnect'/>
    <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
    <link href='https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,400..600&amp;family=Inter:wght@400..700&amp;display=swap' rel='stylesheet'/>

    <!--
      Anti-flash de tema: resolve a preferência (localStorage ou sistema)
      ANTES da primeira pintura. O arquivo principal (defer) assume daqui em diante.
    -->
    <script>
    //<![CDATA[
    (function () {
      try {
        var p = localStorage.getItem("btp-tema");
        if (p !== "claro" && p !== "escuro" && p !== "auto") p = "auto";
        var escuro = p === "escuro" || (p === "auto" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
        var r = document.documentElement;
        r.setAttribute("data-tema", escuro ? "escuro" : "claro");
        r.setAttribute("data-tema-pref", p);
      } catch (e) { /* armazenamento indisponível: fica no modo claro */ }
    })();
    //]]>
    </script>

    <!-- Design system do tema (tokens + componentes) -->
    <b:skin><![CDATA[
/*
<Group description="Cores do tema (Designer de Temas)" selector="body">
<Variable name="keycolor" description="Cor de destaque" type="color" default="#9c4526" value="#9c4526"/>
<Variable name="body.background.color" description="Cor de fundo (modo claro)" type="color" default="#faf8f3" value="#faf8f3"/>
<Variable name="text.color" description="Cor do texto (modo claro)" type="color" default="#1f1b16" value="#1f1b16"/>
</Group>
*/
/*@STYLES_CSS@*/
]]></b:skin>
  </head>

  <body>
    <!-- Estados de vista usados pelo CSS (grade com/sem sidebar, erros etc.) -->
    <b:class cond='data:view.isSingleItem' name='vista-post'/>
    <b:class cond='data:view.isMultipleItems' name='vista-lista'/>
    <b:class cond='data:view.isPage' name='vista-pagina'/>
    <b:class cond='data:view.isError' name='vista-erro'/>

    <!-- Barra de progresso de leitura (preenchida por JS nos posts) -->
    <div aria-hidden='true' class='progresso' id='progresso'><span></span></div>

    <!-- Atalho de acessibilidade -->
    <a class='pular' href='#conteudo'>Pular para o conteúdo</a>

    <!-- ==================================================================
         CABEÇALHO — fixo, some ao rolar para baixo, volta ao subir
         ================================================================== -->
    <header class='topo' id='topo'>
      <div class='container topo__linha'>
        <b:section class='marca' id='topo-marca' maxwidgets='1' name='Marca' showaddelement='no'>
          <b:widget id='Header1' locked='true' title='Tinta &amp; Papel (Cabeçalho)' type='Header' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='displayUrl'/>
              <b:widget-setting name='displayHeight'>0</b:widget-setting>
              <b:widget-setting name='sectionWidth'>-1</b:widget-setting>
              <b:widget-setting name='useImage'>false</b:widget-setting>
              <b:widget-setting name='shrinkToFit'>false</b:widget-setting>
              <b:widget-setting name='imagePlacement'>BEHIND</b:widget-setting>
              <b:widget-setting name='displayWidth'>0</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main' var='this'>
              <b:if cond='data:imagePlacement in {&quot;REPLACE&quot;, &quot;BEFORE_DESCRIPTION&quot;} and data:sourceUrl'>
                <a class='marca__titulo' expr:href='data:blog.homepageUrl'>
                  <img expr:alt='data:blog.title' expr:src='data:sourceUrl'/>
                </a>
                <b:if cond='data:imagePlacement == &quot;BEFORE_DESCRIPTION&quot; and data:this.description != &quot;&quot;'>
                  <p class='marca__descricao'><data:this.description/></p>
                </b:if>
              <b:else/>
                <a class='marca__titulo' expr:href='data:blog.homepageUrl'><data:blog.title/></a>
                <b:if cond='data:this.description != &quot;&quot;'>
                  <p class='marca__descricao'><data:this.description/></p>
                </b:if>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>

        <nav aria-label='Menu principal' class='topo__nav' id='topo-nav'>
          <button aria-label='Fechar menu' class='botao-icone menu-fechar' data-acao='fechar-menu' type='button'>
            <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
          </button>
          <b:section class='menu-principal' id='topo-menu' name='Menu principal' showaddelement='yes'>
            <b:widget id='PageList1' locked='false' title='Páginas' type='PageList' visible='true'>
              <b:widget-settings>
                <b:widget-setting name='homeTitle'>Início</b:widget-setting>
              </b:widget-settings>
              <b:includable id='main'>
                <ul class='menu__lista'>
                  <b:loop values='data:links' var='link'>
                    <li>
                      <b:class cond='data:link.isCurrentPage' name='menu__item--atual'/>
                      <a expr:href='data:link.href'><data:link.title/></a>
                    </li>
                  </b:loop>
                </ul>
              </b:includable>
            </b:widget>
          </b:section>
        </nav>

        <div class='topo__acoes'>
          <button aria-label='Buscar no blog' class='botao-icone' data-acao='abrir-busca' type='button'>
            <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><circle cx='11' cy='11' r='7'/><path d='m20.5 20.5-4.6-4.6'/></svg>
          </button>
          <button aria-label='Alternar tema' class='botao-icone' data-acao='alternar-tema' title='Tema' type='button'>
            <svg class='icone-tema icone-tema--sol' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/></svg>
            <svg class='icone-tema icone-tema--lua' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'/></svg>
            <svg class='icone-tema icone-tema--auto' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><rect height='13' rx='2' width='19' x='2.5' y='4'/><path d='M9 21h6M12 17v4'/><path d='M12 4v13' opacity='0.5'/></svg>
          </button>
          <button aria-controls='topo-nav' aria-expanded='false' aria-label='Abrir menu' class='botao-icone botao-menu' data-acao='abrir-menu' type='button'>
            <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M4 6h16M4 12h16M4 18h16'/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Fundo escurecido do menu mobile -->
    <div id='lateral-fundo' class='lateral-fundo' aria-hidden='true'></div>

    <!-- ==================================================================
         BUSCA EM OVERLAY (atalho de teclado: /)
         ================================================================== -->
    <div aria-label='Buscar no blog' aria-modal='true' class='busca-overlay' id='busca-overlay' role='dialog'>
      <button aria-label='Fechar busca' class='botao-icone busca-overlay__fechar' data-acao='fechar-busca' type='button'>
        <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
      </button>
      <b:section class='busca-overlay__corpo' id='busca-topo' maxwidgets='1' name='Busca' showaddelement='no'>
        <b:widget id='BlogSearch1' locked='false' title='Buscar no blog' type='BlogSearch' visible='true'>
          <b:includable id='main'>
            <form class='busca__form' expr:action='data:blog.searchUrl' role='search'>
              <b:attr cond='not data:view.isPreview' name='target' value='_top'/>
              <b:include name='urlParamsAsFormInput'/>
              <input autocomplete='off' class='busca__entrada' expr:aria-label='data:messages.searchThisBlog' expr:placeholder='data:messages.searchThisBlog' expr:value='data:view.isSearch ? data:view.search.query.escaped : &quot;&quot;' name='q' type='search'/>
              <button class='botao' type='submit'>Buscar</button>
            </form>
          </b:includable>
        </b:widget>
      </b:section>
    </div>

    <!-- ==================================================================
         CONTEÚDO — widget Blog + barra lateral
         ================================================================== -->
    <main class='conteudo container' id='conteudo'>
      <div class='layout'>
        <div class='layout__principal'>
          <b:section class='principal' id='principal' maxwidgets='1' name='Principal' showaddelement='no'>
            <b:widget id='Blog1' locked='true' title='Postagens do blog' type='Blog' visible='true'>
/*@BLOG_WIDGET@*/
            </b:widget>
          </b:section>
        </div>

        <aside aria-label='Barra lateral' class='layout__lateral' id='lateral'>
          <b:section class='sidebar' id='lateral-widgets' name='Barra lateral' showaddelement='yes'>
            <b:widget id='PopularPosts1' locked='false' title='Populares' type='PopularPosts' visible='true'>
              <b:widget-settings>
                <b:widget-setting name='numItemsToShow'>4</b:widget-setting>
                <b:widget-setting name='showThumbnails'>true</b:widget-setting>
                <b:widget-setting name='showSnippets'>false</b:widget-setting>
                <b:widget-setting name='timeRange'>LAST_YEAR</b:widget-setting>
              </b:widget-settings>
              <b:includable id='main'>
                <h3 class='widget-titulo'><data:title/></h3>
                <ol class='populares__lista'>
                  <b:loop values='data:posts' var='post'>
                    <li class='populares__item'>
                      <a class='populares__link' expr:href='data:post.url'>
                        <b:if cond='data:post.featuredImage'>
                          <img class='populares__thumb' decoding='async' expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 112, &quot;1:1&quot;)' height='56' loading='lazy' width='56'/>
                        </b:if>
                        <span class='populares__titulo'><data:post.title/></span>
                      </a>
                    </li>
                  </b:loop>
                </ol>
              </b:includable>
            </b:widget>

            <b:widget id='Profile1' locked='false' title='Sobre o autor' type='Profile' visible='true'>
              <b:widget-settings>
                <b:widget-setting name='showaboutme'>true</b:widget-setting>
                <b:widget-setting name='showlocation'>true</b:widget-setting>
              </b:widget-settings>
              <b:includable id='main'>
                <h3 class='widget-titulo'><data:title/></h3>
                <div class='perfil'>
                  <b:if cond='data:this.team'>
                    <ul class='perfil__autores'>
                      <b:loop values='data:authors' var='author'>
                        <li><a expr:href='data:author.userUrl' rel='nofollow'><data:author.display-name/></a></li>
                      </b:loop>
                    </ul>
                  <b:else/>
                    <b:if cond='data:authorPhoto.image'>
                      <img class='perfil__foto' decoding='async' expr:alt='data:messages.myPhoto' expr:src='data:authorPhoto.image' height='72' loading='lazy' width='72'/>
                    </b:if>
                    <p class='perfil__nome'>
                      <a expr:href='data:userUrl' rel='nofollow'><data:displayname/></a>
                    </p>
                    <b:if cond='data:aboutme != &quot;&quot;'>
                      <p class='perfil__bio'><data:aboutme/></p>
                    </b:if>
                    <b:if cond='data:showlocation and data:location != &quot;&quot;'>
                      <p class='perfil__local'><data:location/></p>
                    </b:if>
                  </b:if>
                </div>
              </b:includable>
            </b:widget>

            <b:widget id='Label1' locked='false' title='Rótulos' type='Label' visible='true'>
              <b:includable id='main'>
                <h3 class='widget-titulo'><data:title/></h3>
                <div class='rotulos__nuvem'>
                  <b:loop values='data:this.labels' var='label'>
                    <a class='chip' expr:href='data:label.url'>
                      <data:label.name/>
                      <b:if cond='data:label.count'>
                        <span class='chip__conta'><data:label.count/></span>
                      </b:if>
                    </a>
                  </b:loop>
                </div>
              </b:includable>
            </b:widget>

            <b:widget id='BlogArchive1' locked='false' title='Arquivo' type='BlogArchive' visible='true'>
              <b:includable id='main'>
                <h3 class='widget-titulo'><data:title/></h3>
                <ul class='arquivo__lista'>
                  <b:loop values='data:this.data' var='i'>
                    <li>
                      <a expr:href='data:i.url'><data:i.name/></a>
                      <b:if cond='data:i.post-count'>
                        <span class='arquivo__conta'><data:i.post-count/></span>
                      </b:if>
                    </li>
                  </b:loop>
                </ul>
              </b:includable>
            </b:widget>
          </b:section>
        </aside>
      </div>
    </main>

    <!-- ==================================================================
         RODAPÉ — banda de tinta com widgets e atribuição
         ================================================================== -->
    <footer class='rodape'>
      <div class='container rodape__grade'>
        <div>
          <p class='marca__assinatura'><data:blog.title/></p>
          <b:section class='rodape-col' id='rodape-sobre' name='Rodapé — Sobre' showaddelement='yes'>
            <b:widget id='HTML1' locked='false' title='Sobre este blog' type='HTML' visible='true'>
              <b:includable id='main'>
                <b:if cond='data:title != &quot;&quot;'>
                  <h3 class='widget-titulo'><data:title/></h3>
                </b:if>
                <div class='widget-corpo'><data:content/></div>
              </b:includable>
            </b:widget>
          </b:section>
          <a class='rodape__rss' expr:href='data:blog.homepageUrl + &quot;feeds/posts/default&quot;' rel='noopener' target='_blank'>
            <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M4 11a9 9 0 0 1 9 9'/><path d='M4 4a16 16 0 0 1 16 16'/><circle cx='5' cy='19' r='1'/></svg>
            Feed RSS
          </a>
        </div>

        <b:section class='rodape-col' id='rodape-links' name='Rodapé — Links' showaddelement='yes'>
          <b:widget id='LinkList1' locked='false' title='Explore' type='LinkList' visible='true'>
            <b:includable id='main'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-titulo'><data:title/></h3>
              </b:if>
              <ul class='lista-links'>
                <b:loop values='data:links' var='link'>
                  <li><a expr:href='data:link.target'><data:link.name/></a></li>
                </b:loop>
              </ul>
            </b:includable>
          </b:widget>
        </b:section>

        <b:section class='rodape-col' id='rodape-extra' name='Rodapé — Extras' showaddelement='yes'></b:section>
      </div>

      <div class='rodape__base'>
        <div class='container rodape__base-linha'>
          <p>© <span id='ano-atual'></span> <data:blog.title/></p>
          <b:section class='atribuicao' id='atribuicao' maxwidgets='1' name='Atribuição' showaddelement='no'>
            <b:widget id='Attribution1' locked='true' title='' type='Attribution' visible='true'>
              <b:widget-settings>
                <b:widget-setting name='copyright'/>
              </b:widget-settings>
              <b:includable id='main'>
                <div class='widget-corpo'>
                  <b:if cond='data:copyright != &quot;&quot;'>
                    <span class='atribuicao__copyright'><data:copyright/></span>
                  </b:if>
                  <a expr:href='data:bloggerUrl' rel='nofollow'><b:message name='messages.poweredByBlogger'/></a>
                </div>
              </b:includable>
            </b:widget>
          </b:section>
        </div>
      </div>
    </footer>

    <!-- ==================================================================
         UTILITÁRIOS FLUTUANTES
         ================================================================== -->
    <button aria-label='Voltar ao topo' class='voltar-topo' id='voltar-topo' type='button'>
      <svg fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.75' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path d='M12 19V5'/><path d='m5 12 7-7 7 7'/></svg>
    </button>
    <div class='toast' id='toast' role='status'></div>

    <!-- Script principal do tema (injetado pelo build) -->
    <script defer='defer'>
    //<![CDATA[
/*@MAIN_JS@*/
    //]]>
    </script>
  </body>
</html>
